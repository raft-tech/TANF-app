<mxfile host="app.diagrams.net" modified="2026-10-22T22:30:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="python-parsing-flow" name="Python Parser Flow">
    <mxGraphModel dx="1900" dy="1680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1680" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_banner" value="&lt;b style=&quot;font-size:24px; color:#0f172a;&quot;&gt;TDP File Upload &amp; Processing Flow — Python Parser Path&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px; color:#475569;&quot;&gt;End-to-End File Upload, Antivirus Scanning, Concurrency Ownership Locking, Transient PythonParserEngine Execution, and Terminal State Transitions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=30;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="30" width="1820" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stage1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="130" width="1820" height="200" as="geometry" />
        </mxCell>
        <mxCell id="stage1_hdr" value="&lt;b style=&quot;font-size:15px; color:#1e293b; letter-spacing:0.5px;&quot;&gt;STAGE 1: FILE INGESTION, ATTRIBUTION, ANTIVIRUS SCANNING &amp; PARSER SCHEDULING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="130" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step1_1" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;1. Ingestion &amp; Source Attribution&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFileViewSet.create&lt;/span&gt; receives upload (UI or REST API)&lt;br&gt;&amp;bull; Writes raw stream to S3: &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;data_files/YYYY/QX/...&lt;/span&gt;&lt;br&gt;&amp;bull; Sets &lt;b&gt;upload_source&lt;/b&gt;: &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;Frontend&lt;/span&gt; or &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;API&lt;/span&gt;&lt;br&gt;&amp;bull; Lifecycle record created in &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFileStateTransition&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;right&quot;&gt;&lt;span style=&quot;background-color:#e0f2fe; border:1px solid #7dd3fc; border-radius:10px; padding:2px 8px; font-weight:bold; color:#0369a1; font-size:11px;&quot;&gt;UPLOADED&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="65" y="185" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="step1_2" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;2. Antivirus Inspection (ClamAV)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Handled asynchronously by &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;clamav_service&lt;/span&gt;&lt;br&gt;&amp;bull; Scans file bytes directly from S3 bucket&lt;br&gt;&amp;bull; On malicious file detection &amp;rarr; terminal rejection&lt;br&gt;&amp;bull; On clean scan &amp;rarr; triggers &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParsingService.schedule()&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;right&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;VIRUS_SCAN_COMPLETED&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;background-color:#fee2e2; border:1px solid #f87171; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b91c1c; font-size:11px;&quot;&gt;VIRUS_SCAN_FAILED&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="485" y="185" width="395" height="130" as="geometry" />
        </mxCell>
        <mxCell id="step1_3" value="&lt;b style=&quot;font-size:14px; color:#0284c7;&quot;&gt;3. ParsingService.schedule() &amp; Mode Resolution&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;ParsingService.schedule(data_file_id)&lt;/b&gt; (alias &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;queue_parse&lt;/span&gt;)&lt;br&gt;&amp;bull; &lt;b&gt;resolve_or_reuse_parser_mode()&lt;/b&gt; checks flag: resolves &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;python-only&lt;/span&gt;&lt;br&gt;&amp;bull; Persists durable route on &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;data_file.parser_mode&lt;/span&gt;&lt;br&gt;&amp;bull; &lt;b&gt;claim_parse(data_file)&lt;/b&gt;: allocates exclusive UUID &lt;b&gt;parse_token&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;center&quot; style=&quot;background-color:#e0f2fe; border:1px solid #7dd3fc; border-radius:4px; padding:3px; font-weight:bold; color:#0369a1; font-family:monospace; font-size:11px;&quot;&gt;Lock Token Fencing: parse_write_scope(data_file.id, parse_token)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="920" y="185" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="step1_4" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;4. Celery Queue Task Enqueue&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Calls &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parse.delay(data_file_id, parse_token=str(parse_token))&lt;/span&gt;&lt;br&gt;&amp;bull; Dispatched to default worker queue: &lt;b&gt;celery&lt;/b&gt;&lt;br&gt;&amp;bull; Python worker process claims background parsing task&lt;br&gt;&amp;bull; Fenced by &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;current_parse_token&lt;/span&gt; to avoid race conditions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1440" y="185" width="395" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge_1_1_to_1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step1_1" target="step1_2" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_1_2_to_1_3" value="CLEAN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#15803d;strokeWidth=2;fontColor=#15803d;fontSize=10;fontStyle=1;endArrow=block;endFill=1;" parent="1" source="step1_2" target="step1_3" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_1_3_to_1_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step1_3" target="step1_4" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="stage2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bae6fd;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="350" width="1820" height="275" as="geometry" />
        </mxCell>
        <mxCell id="stage2_hdr" value="&lt;b style=&quot;font-size:15px; color:#ffffff;&quot;&gt;STAGE 2: CELERY WORKER EXECUTION &amp; TRANSIENT PYTHONPARSERENGINE ORCHESTRATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="350" width="1820" height="42" as="geometry" />
        </mxCell>
        <mxCell id="step2_1" value="&lt;b style=&quot;font-size:14px; color:#166534;&quot;&gt;1. Celery Hook &amp; Service Initialization&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Celery task: &lt;b&gt;parse(data_file_id, reparse_id, parse_token)&lt;/b&gt;&lt;br&gt;&amp;bull; Instantiates &lt;b&gt;ParsingService(data_file=data_file, parse_token=parse_token)&lt;/b&gt;&lt;br&gt;&amp;bull; Records transition to &lt;b&gt;PARSE_STARTED&lt;/b&gt; in audit table&lt;br&gt;&amp;bull; Calls &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;validate_preconditions()&lt;/span&gt;: verifies file presence &amp; ownership token&lt;br&gt;&amp;bull; Creates &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFileSummary&lt;/span&gt; with initial status &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;PENDING&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;right&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;PARSE_STARTED&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="65" y="410" width="420" height="195" as="geometry" />
        </mxCell>
        <mxCell id="step2_2" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;2. Transient PythonParserEngine Execution&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Instantiates &lt;b&gt;PythonParserEngine(data_file=data_file)&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParserFactory.get_instance()&lt;/span&gt; selects domain parser:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;TanfDataReportParser&lt;/span&gt; (TANF Active/Closed/Agg/Stratum)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;SSPParser&lt;/span&gt; (Separate State Programs)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;TribalParser&lt;/span&gt; (Tribal TANF sections)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;FRAParser&lt;/span&gt; (FRA Work Outcomes)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ProgramAuditParser&lt;/span&gt; (Program Audit files)&lt;br&gt;&amp;bull; &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;engine.execute()&lt;/span&gt; &amp;rarr; calls &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parser.parse_and_validate()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="515" y="410" width="435" height="195" as="geometry" />
        </mxCell>
        <mxCell id="step2_3" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;3. Fenced Database Record Serialization&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Enters &lt;b&gt;parse_write_scope(data_file.id, parse_token)&lt;/b&gt; context&lt;br&gt;&amp;bull; Validates row fields, cross-month aggregates, &amp; case consistency&lt;br&gt;&amp;bull; Persists extracted records into models (e.g. &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;tanf_t1...t7&lt;/span&gt;)&lt;br&gt;&amp;bull; Persists errors into &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParserError&lt;/span&gt; table&lt;br&gt;&amp;bull; Memory Safe: streams rows in batches without loading full file into memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="980" y="410" width="415" height="195" as="geometry" />
        </mxCell>
        <mxCell id="step2_4" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;4. Summary Aggregation &amp; Email Alerts&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;update_dfs()&lt;/b&gt; computes case counts, category totals, &amp; status&lt;br&gt;&amp;bull; &lt;b&gt;_finalize_parse()&lt;/b&gt; invokes &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ErrorReportFactory&lt;/span&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- Generates formatted Excel error report (&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;.xlsx&lt;/span&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- Saves artifact to S3 and attaches to summary&lt;br&gt;&amp;bull; &lt;b&gt;send_data_submitted_email()&lt;/b&gt; emails STT Data Analysts&lt;br&gt;&amp;bull; Returns lightweight &lt;b&gt;ParseResult&lt;/b&gt; (serializable dictionary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1425" y="410" width="410" height="195" as="geometry" />
        </mxCell>
        <mxCell id="edge_1_4_to_2_1" value="Celery Worker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;fontColor=#0284c7;fontSize=10;fontStyle=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="step1_4" target="step2_1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1637" y="330" />
              <mxPoint x="275" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_2_1_to_2_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step2_1" target="step2_2" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_2_2_to_2_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step2_2" target="step2_3" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_2_3_to_2_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step2_3" target="step2_4" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="stage3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="645" width="1820" height="230" as="geometry" />
        </mxCell>
        <mxCell id="stage3_hdr" value="&lt;b style=&quot;font-size:15px; color:#1e293b;&quot;&gt;STAGE 3: TERMINAL LIFECYCLE STATE OUTCOMES &amp; METRICS AUDITING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="645" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="out1" value="&lt;b style=&quot;font-size:14px; color:#15803d;&quot;&gt;Outcome 1: Clean Parse Success&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Summary Status: &lt;span style=&quot;background:transparent; background-color:transparent; color:#15803d; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ACCEPTED&lt;/span&gt; (0 errors encountered)&lt;br&gt;&amp;bull; State: &lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;PARSE_COMPLETED&lt;/span&gt;&lt;br&gt;&amp;bull; All records committed to production tables&lt;br&gt;&amp;bull; Metrics: &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;execution_duration_ms&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;total_records_processed&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parser_class&lt;/span&gt;&lt;br&gt;&amp;bull; Exclusive ownership token released: &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;current_parse_token = None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="65" y="700" width="560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="out2" value="&lt;b style=&quot;font-size:14px; color:#b45309;&quot;&gt;Outcome 2: Parsed with Validation Errors&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Summary Status: &lt;span style=&quot;background:transparent; background-color:transparent; color:#b45309; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ACCEPTED_WITH_ERRORS&lt;/span&gt; or &lt;span style=&quot;background:transparent; background-color:transparent; color:#b45309; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;PARTIALLY_ACCEPTED&lt;/span&gt;&lt;br&gt;&amp;bull; State: &lt;span style=&quot;background-color:#fef3c7; border:1px solid #f59e0b; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b45309; font-size:11px;&quot;&gt;PARSED_WITH_ERRORS&lt;/span&gt;&lt;br&gt;&amp;bull; Non-fatal errors recorded in &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParserError&lt;/span&gt; table&lt;br&gt;&amp;bull; Formatted Excel error report generated and available for download in UI&lt;br&gt;&amp;bull; Email sent notifying analysts of errors; lock released: &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;current_parse_token = None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="670" y="700" width="560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="out3" value="&lt;b style=&quot;font-size:14px; color:#b91c1c;&quot;&gt;Outcome 3: Technical / Uncaught Failure&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Summary Status: &lt;span style=&quot;background:transparent; background-color:transparent; color:#b91c1c; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;REJECTED&lt;/span&gt;&lt;br&gt;&amp;bull; State: &lt;span style=&quot;background-color:#fee2e2; border:1px solid #f87171; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b91c1c; font-size:11px;&quot;&gt;PARSE_FAILED&lt;/span&gt;&lt;br&gt;&amp;bull; Trigger: Uncaught exception, decode error, or database failure&lt;br&gt;&amp;bull; Fallback: &lt;span style=&quot;background:transparent; background-color:transparent; color:#b91c1c; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;MSG_ONLY_PRECHECK&lt;/span&gt; error record created for analyst visibility&lt;br&gt;&amp;bull; Technical details &amp; exception message recorded in transition metadata; lock released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1275" y="700" width="560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="edge_2_4_to_out1" value="0 Errors" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#15803d;strokeWidth=1.8;fontColor=#15803d;fontSize=10;fontStyle=1;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" parent="1" source="step2_4" target="out1" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_2_4_to_out2" value="Validation Errors" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b45309;strokeWidth=1.8;fontColor=#b45309;fontSize=10;fontStyle=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="step2_4" target="out2" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_2_4_to_out3" value="Exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b91c1c;strokeWidth=1.8;fontColor=#b91c1c;fontSize=10;fontStyle=1;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" parent="1" source="step2_4" target="out3" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="stage4_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="895" width="1820" height="225" as="geometry" />
        </mxCell>
        <mxCell id="stage4_hdr" value="&lt;b style=&quot;font-size:15px; color:#1e293b;&quot;&gt;ARCHITECTURAL CONCEPTS &amp; DESIGN PATTERNS (PYTHON PARSER PATH)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="895" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card1" value="&lt;b style=&quot;font-size:13px; color:#1e40af;&quot;&gt;Permanent Lifecycle Orchestrator&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParsingService&lt;/span&gt; is the permanent lifecycle backbone&lt;br&gt;&amp;bull; Owns dispatching, scheduling, tokens, &amp; terminal transitions&lt;br&gt;&amp;bull; Does NOT get deleted when Python parser is retired!&lt;br&gt;&amp;bull; Single source of truth for submission state transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="65" y="950" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="card2" value="&lt;b style=&quot;font-size:13px; color:#92400e;&quot;&gt;Transient Engine Decoupling&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;span style=&quot;background:transparent; background-color:transparent; color:#92400e; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;PythonParserEngine&lt;/span&gt; encapsulates legacy parsing&lt;br&gt;&amp;bull; Selects parser class, decodes file bytes, executes parsing&lt;br&gt;&amp;bull; Isolated behind a clean strategy interface&lt;br&gt;&amp;bull; When Python is retired, only this transient engine is removed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="515" y="950" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="card3" value="&lt;b style=&quot;font-size:13px; color:#166534;&quot;&gt;Lock Fencing (parse_write_scope)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Exclusive UUID &lt;span style=&quot;background:transparent; background-color:transparent; color:#166534; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parse_token&lt;/span&gt; assigned on dispatch&lt;br&gt;&amp;bull; Every DB write verifies &lt;span style=&quot;background:transparent; background-color:transparent; color:#166534; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;token == current_parse_token&lt;/span&gt;&lt;br&gt;&amp;bull; Prevents stale retries or duplicate uploads from overwriting data&lt;br&gt;&amp;bull; Releases token upon terminal state transition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="965" y="950" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="card4" value="&lt;b style=&quot;font-size:13px; color:#065f46;&quot;&gt;Memory Safety &amp; Lightweight Dicts&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Prevents OOM crashes on files with 50,000+ row errors&lt;br&gt;&amp;bull; Errors fetched lazily; count stored as primitive integer&lt;br&gt;&amp;bull; &lt;span style=&quot;background:transparent; background-color:transparent; color:#065f46; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParseResult.to_dict()&lt;/span&gt; serializes scalar values&lt;br&gt;&amp;bull; Celery task returns lightweight JSON dictionary to broker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1415" y="950" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stage5_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="1140" width="1820" height="500" as="geometry" />
        </mxCell>
        <mxCell id="stage5_hdr" value="&lt;b style=&quot;font-size:15px; color:#1e293b;&quot;&gt;SUBMISSION LIFECYCLE STATES GLOSSARY (PYTHON PARSER PATH)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="1140" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="glossary_table" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-size:12px; color:#1e293b;&quot;&gt;&lt;tr style=&quot;background-color:#f1f5f9; text-align:left; border-bottom:2px solid #cbd5e1;&quot;&gt;  &lt;th style=&quot;padding:8px 12px; width:180px;&quot;&gt;SubmissionState&lt;/th&gt;  &lt;th style=&quot;padding:8px 12px; width:160px;&quot;&gt;Trigger / Component&lt;/th&gt;  &lt;th style=&quot;padding:8px 12px; width:180px;&quot;&gt;Target Model / Field&lt;/th&gt;  &lt;th style=&quot;padding:8px 12px;&quot;&gt;Description &amp; Lifecycle Behavior&lt;/th&gt;  &lt;th style=&quot;padding:8px 12px; width:100px; text-align:center;&quot;&gt;Terminal?&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#ffffff;&quot;&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background-color:#e0f2fe; border:1px solid #7dd3fc; border-radius:10px; padding:2px 8px; font-weight:bold; color:#0369a1; font-size:11px;&quot;&gt;UPLOADED&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFileViewSet.create&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile.state&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;Initial state recorded when file bytes are received and stored in S3. Pre-scan queue state.&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px; text-align:center; color:#64748b;&quot;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#f8fafc;&quot;&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background-color:#fef3c7; border:1px solid #f59e0b; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b45309; font-size:11px;&quot;&gt;VIRUS_SCAN_STARTED&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;clamav_service&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile.state&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;ClamAV worker claims file for scanning; locks file from concurrent processing until scan finishes.&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px; text-align:center; color:#64748b;&quot;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#ffffff;&quot;&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;VIRUS_SCAN_COMPLETED&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;clamav_service&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile.state&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;File passed antivirus scan with clean status. Eligible for &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;claim_parse()&lt;/span&gt; and queueing.&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px; text-align:center; color:#64748b;&quot;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#f8fafc;&quot;&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background-color:#fee2e2; border:1px solid #f87171; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b91c1c; font-size:11px;&quot;&gt;VIRUS_SCAN_FAILED&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;clamav_service&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile.state&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;Malicious signature detected in upload. File is quarantined; no parser worker will ever touch it.&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px; text-align:center; font-weight:bold; color:#b91c1c;&quot;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#ffffff;&quot;&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;PARSE_STARTED&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParsingService.run&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile.state&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;Celery worker has verified ownership lock (&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parse_token&lt;/span&gt;) and begun execution with &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;PythonParserEngine&lt;/span&gt;.&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px; text-align:center; color:#64748b;&quot;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#f8fafc;&quot;&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;PARSE_COMPLETED&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;_transition_parse_outcome&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile.state&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;Terminal success state. Zero validation errors. &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFileSummary.status&lt;/span&gt; is &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ACCEPTED&lt;/span&gt;. Token released.&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px; text-align:center; font-weight:bold; color:#15803d;&quot;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#ffffff;&quot;&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background-color:#fef3c7; border:1px solid #f59e0b; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b45309; font-size:11px;&quot;&gt;PARSED_WITH_ERRORS&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;_transition_parse_outcome&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile.state&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;Terminal outcome where row/field errors were found. Summary marked &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ACCEPTED_WITH_ERRORS&lt;/span&gt;; Excel report generated.&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px; text-align:center; font-weight:bold; color:#b45309;&quot;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc;&quot;&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background-color:#fee2e2; border:1px solid #f87171; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b91c1c; font-size:11px;&quot;&gt;PARSE_FAILED&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;_record_failed_parse&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile.state&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px;&quot;&gt;Terminal failure state from unexpected exceptions, decoding crashes, or database connection errors. Summary marked &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;REJECTED&lt;/span&gt;.&lt;/td&gt;  &lt;td style=&quot;padding:8px 12px; text-align:center; font-weight:bold; color:#b91c1c;&quot;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="65" y="1195" width="1770" height="425" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
