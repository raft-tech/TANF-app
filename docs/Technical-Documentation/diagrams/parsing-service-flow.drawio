<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-22T12:50:00.000Z" agent="Antigravity" version="21.0.0" type="device"><diagram id="parsing-service-flow" name="Parsing Service Flow"><mxGraphModel dx="2200" dy="1580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1580" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header_banner" value="&lt;b style=&quot;font-size:24px; color:#0f172a;&quot;&gt;TDP Parsing Service Architecture &amp;amp; Lifecycle Flow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px; color:#475569;&quot;&gt;Permanent Lifecycle Orchestration, Transient PythonParserEngine, Unified Go Finalization, &amp;amp; Ultra-Thin Celery Hooks (#5570)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=30;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="2120" height="90" as_="geometry" /></mxCell><mxCell id="stage1_container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="140" width="2120" height="230" as_="geometry" /></mxCell><mxCell id="stage1_header" value="&lt;b style=&quot;font-size:15px; color:#1e293b; letter-spacing:0.5px;&quot;&gt;STAGE 1: FILE INGESTION, ATTRIBUTION, VIRUS SCANNING &amp;amp; PARSER DISPATCH&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="140" width="2120" height="42" as_="geometry" /></mxCell><mxCell id="step_1_1" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;1. Ingestion &amp;amp; Source Attribution&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;code&gt;DataFileViewSet.create&lt;/code&gt; sets &lt;b&gt;upload_source&lt;/b&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;code&gt;Frontend&lt;/code&gt; (UI session) | &lt;code&gt;API&lt;/code&gt; (Bearer token)&lt;br&gt;&amp;bull; Source passed to AV scan &amp;amp; lifecycle transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="70" y="200" width="370" height="150" as_="geometry" /></mxCell><mxCell id="step_1_2" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;2. Asynchronous Antivirus Scan&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Handled by &lt;code&gt;clamav_service&lt;/code&gt;&lt;br&gt;&amp;bull; On completion, triggers &lt;code&gt;ParsingService.schedule()&lt;/code&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;VIRUS_SCAN_COMPLETED&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;background-color:#fee2e2; border:1px solid #f87171; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b91c1c; font-size:11px;&quot;&gt;VIRUS_SCAN_FAILED&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="485" y="200" width="365" height="150" as_="geometry" /></mxCell><mxCell id="edge_1_1_to_1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step_1_1" target="step_1_2" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="step_1_3" value="&lt;b style=&quot;font-size:14px; color:#1d4ed8;&quot;&gt;3. ParsingService.schedule() &amp;amp; Concurrency Ownership Guard&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;ParsingService.schedule()&lt;/b&gt; (alias &lt;code&gt;queue_parse&lt;/code&gt;): routes &amp;amp; locks&lt;br&gt;&amp;bull; &lt;b&gt;resolve_or_reuse_parser_mode()&lt;/b&gt;: routes &lt;code&gt;python-only&lt;/code&gt; | &lt;code&gt;go-shadow&lt;/code&gt; | &lt;code&gt;go-only&lt;/code&gt;&lt;br&gt;&amp;bull; &lt;b&gt;claim_parse(data_file)&lt;/b&gt;: allocates exclusive UUID &lt;code&gt;parse_token&lt;/code&gt; lock&lt;br&gt;&amp;bull; If shadow: &lt;b&gt;create_or_update_shadow_data_file()&lt;/b&gt; syncs section &amp;amp; upload_source&lt;br&gt;&lt;br&gt;&lt;div align=&quot;center&quot; style=&quot;background-color:#dbeafe; border:1px solid #93c5fd; border-radius:4px; padding:4px; font-weight:bold; color:#1e40af; font-family:monospace; font-size:11px;&quot;&gt;Lock Token Fencing: parse_write_scope(data_file.id, parse_token)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="895" y="195" width="680" height="160" as_="geometry" /></mxCell><mxCell id="edge_1_2_to_1_3" value="PASS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;strokeWidth=2;fontColor=#64748b;fontSize=11;fontStyle=1;endArrow=block;endFill=1;" parent="1" source="step_1_2" target="step_1_3" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="step_1_4" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;4. Celery Queue Task Dispatch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dispatches parsing workload across worker queues:&lt;br&gt;&lt;br&gt;&lt;div style=&quot;background-color:#f1f5f9; border:1px solid #cbd5e1; border-radius:4px; padding:3px 6px; margin-bottom:4px;&quot;&gt;&lt;b style=&quot;color:#0284c7; font-family:monospace;&quot;&gt;python-only&lt;/b&gt; &amp;rarr; Queue: &lt;code&gt;celery&lt;/code&gt; (&lt;code&gt;parse.delay&lt;/code&gt;)&lt;/div&gt;&lt;div style=&quot;background-color:#f1f5f9; border:1px solid #cbd5e1; border-radius:4px; padding:3px 6px; margin-bottom:4px;&quot;&gt;&lt;b style=&quot;color:#7c3aed; font-family:monospace;&quot;&gt;go-shadow&lt;/b&gt; &amp;rarr; Dual: &lt;code&gt;celery&lt;/code&gt; AND &lt;code&gt;go-parser&lt;/code&gt;&lt;/div&gt;&lt;div style=&quot;background-color:#f1f5f9; border:1px solid #cbd5e1; border-radius:4px; padding:3px 6px;&quot;&gt;&lt;b style=&quot;color:#059669; font-family:monospace;&quot;&gt;go-only&lt;/b&gt; &amp;rarr; Queue: &lt;code&gt;go-parser&lt;/code&gt; (&lt;code&gt;go_parse&lt;/code&gt; only)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="1620" y="195" width="510" height="160" as_="geometry" /></mxCell><mxCell id="edge_1_3_to_1_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2563eb;strokeWidth=2.5;endArrow=block;endFill=1;" parent="1" source="step_1_3" target="step_1_4" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="col_a_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bae6fd;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="390" width="670" height="845" as_="geometry" /></mxCell><mxCell id="col_a_hdr" value="&lt;b style=&quot;font-size:15px; color:#ffffff;&quot;&gt;PATH A: python-only (ParsingService.run())&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=none;align=left;spacingLeft=20;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="390" width="670" height="48" as_="geometry" /></mxCell><mxCell id="path_a_step1" value="&lt;b style=&quot;font-size:14px; color:#166534;&quot;&gt;1. Ultra-Thin Celery Hook &amp;amp; Service Delegation&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Celery task: &lt;b&gt;parse(data_file_id, reparse_id, parse_token)&lt;/b&gt;&lt;br&gt;&amp;bull; Instantiates &lt;b&gt;ParsingService(data_file=data_file, ...)&lt;/b&gt;&lt;br&gt;&amp;bull; Executes &lt;b&gt;result = service.run()&lt;/b&gt; and returns &lt;b&gt;result.to_dict()&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;right&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 10px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;PARSE_STARTED&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="65" y="460" width="620" height="115" as_="geometry" /></mxCell><mxCell id="path_a_step2" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;2. Preconditions &amp;amp; PythonParserEngine Execution&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;validate_preconditions()&lt;/b&gt;: checks file presence, valid state, token guard&lt;br&gt;&amp;bull; Delegates to transient &lt;b&gt;PythonParserEngine&lt;/b&gt; (&lt;code&gt;ParserFactory&lt;/code&gt;):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;code&gt;TanfDataReportParser&lt;/code&gt; (TANF / SSP / Tribal)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;code&gt;FRAParser&lt;/code&gt; (FRA) | &lt;code&gt;ProgramAuditParser&lt;/code&gt; (Audit)&lt;br&gt;&amp;bull; &lt;code&gt;engine.execute()&lt;/code&gt;: streams records into database&lt;br&gt;&amp;bull; Isolated engine: deleted when Python is retired (Zero lifecycle impact)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="65" y="600" width="620" height="160" as_="geometry" /></mxCell><mxCell id="edge_a1_a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="path_a_step1" target="path_a_step2" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="path_a_step3" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;3. Artifacts, Metrics &amp;amp; ParseResult Dataclass&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;_finalize_parse()&lt;/b&gt;: generates Excel error report (&lt;code&gt;ErrorReportFactory&lt;/code&gt;)&lt;br&gt;&amp;bull; &lt;b&gt;_get_execution_metadata()&lt;/b&gt;: duration_ms, record count, error count&lt;br&gt;&amp;bull; &lt;b&gt;_transition_parse_outcome()&lt;/b&gt;: records metadata in &lt;code&gt;DataFileStateTransition&lt;/code&gt;&lt;br&gt;&amp;bull; Returns &lt;b&gt;ParseResult&lt;/b&gt; (synchronous) / &lt;b&gt;ParseResult.to_dict()&lt;/b&gt; (Celery)&lt;br&gt;&lt;br&gt;&lt;div align=&quot;center&quot; style=&quot;background-color:#f1f5f9; border:1px solid #e2e8f0; border-radius:4px; padding:3px; color:#475569; font-family:monospace; font-size:11px;&quot;&gt;Memory Safe: Returns total_errors_generated int (No OOM error model dumps)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="65" y="785" width="620" height="150" as_="geometry" /></mxCell><mxCell id="edge_a2_a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="path_a_step2" target="path_a_step3" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="path_a_step4" value="&lt;b style=&quot;font-size:14px; color:#0369a1;&quot;&gt;4. Terminal Lifecycle State Outcomes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;background-color:#ffffff; border:1px solid #86efac; border-radius:6px; padding:6px; margin-bottom:6px;&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;PARSE_COMPLETED&lt;/span&gt;&amp;nbsp;&lt;b&gt;0 Errors&lt;/b&gt; &amp;bull; Summary: &lt;code&gt;ACCEPTED&lt;/code&gt;&lt;br&gt;&lt;span style=&quot;color:#64748b; font-size:11px;&quot;&gt;Metrics logged: execution_duration_ms, total_records_processed&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background-color:#ffffff; border:1px solid #fcd34d; border-radius:6px; padding:6px; margin-bottom:6px;&quot;&gt;&lt;span style=&quot;background-color:#fef3c7; border:1px solid #f59e0b; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b45309; font-size:11px;&quot;&gt;PARSED_WITH_ERRORS&lt;/span&gt;&amp;nbsp;&lt;b&gt;Validation Failures&lt;/b&gt; &amp;bull; Summary: &lt;code&gt;ACCEPTED_WITH_ERRORS&lt;/code&gt;&lt;br&gt;&lt;span style=&quot;color:#64748b; font-size:11px;&quot;&gt;Error report attached to summary; metrics appended to transition&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background-color:#ffffff; border:1px solid #fca5a5; border-radius:6px; padding:6px;&quot;&gt;&lt;span style=&quot;background-color:#fee2e2; border:1px solid #f87171; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b91c1c; font-size:11px;&quot;&gt;PARSE_FAILED&lt;/span&gt;&amp;nbsp;&lt;b&gt;Technical Failure&lt;/b&gt; &amp;bull; Summary: &lt;code&gt;REJECTED&lt;/code&gt;&lt;br&gt;&lt;span style=&quot;color:#64748b; font-size:11px;&quot;&gt;Exception caught, MSG_ONLY_PRECHECK user error persisted&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="65" y="960" width="620" height="250" as_="geometry" /></mxCell><mxCell id="edge_a3_a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="path_a_step3" target="path_a_step4" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="col_b_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ddd6fe;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="765" y="390" width="670" height="845" as_="geometry" /></mxCell><mxCell id="col_b_hdr" value="&lt;b style=&quot;font-size:15px; color:#ffffff;&quot;&gt;PATH B: go-shadow (Dual Dispatch &amp;amp; Shadow Tables)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=none;align=left;spacingLeft=20;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="765" y="390" width="670" height="48" as_="geometry" /></mxCell><mxCell id="path_b_step1" value="&lt;b style=&quot;font-size:14px; color:#5b21b6;&quot;&gt;1. Dual Task Dispatch &amp;amp; Shadow State&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;ParsingService.schedule()&lt;/b&gt; dispatches parallel tasks:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;1. Python: &lt;code&gt;ParsingService(data_file).run()&lt;/code&gt; &amp;rarr; Production&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;2. Go: &lt;code&gt;queue_go_parse(table_mode=&quot;go-shadow&quot;)&lt;/code&gt; &amp;rarr; Shadow&lt;br&gt;&amp;bull; &lt;code&gt;ShadowDataFile&lt;/code&gt; initialized in &lt;code&gt;PARSE_STARTED&lt;/code&gt; state&lt;br&gt;&lt;br&gt;&lt;div align=&quot;right&quot;&gt;&lt;span style=&quot;background-color:#f5f3ff; border:1px solid #c4b5fd; border-radius:10px; padding:2px 10px; font-weight:bold; color:#6d28d9; font-size:11px;&quot;&gt;DUAL DISPATCH&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="790" y="460" width="620" height="115" as_="geometry" /></mxCell><mxCell id="path_b_step2" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;2. Shadow Parser Model Isolation&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Go parser worker reads from &lt;code&gt;go-parser&lt;/code&gt; Celery queue&lt;br&gt;&amp;bull; Parses file bytes concurrently without locking production records&lt;br&gt;&amp;bull; Writes records &amp;amp; errors strictly to shadow partition:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;code&gt;shadow_tanf_t1...t7&lt;/code&gt;, &lt;code&gt;ShadowParserError&lt;/code&gt;&lt;br&gt;&amp;bull; Completely isolated from user-facing queries and API responses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="790" y="600" width="620" height="160" as_="geometry" /></mxCell><mxCell id="edge_b1_b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="path_b_step1" target="path_b_step2" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="path_b_step3" value="&lt;b style=&quot;font-size:14px; color:#166534;&quot;&gt;3. Unified ParsingService.post_parse() Finalization&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Celery task &lt;b&gt;post_parse(data_file_id, table_mode=&quot;go-shadow&quot;)&lt;/b&gt;&lt;br&gt;&amp;bull; Instantiates &lt;b&gt;ParsingService.for_post_parse(table_mode=&quot;go-shadow&quot;)&lt;/b&gt;&lt;br&gt;&amp;bull; Bound to &lt;b&gt;ShadowDataFile&lt;/b&gt; model &amp;amp; &lt;b&gt;ShadowDataFileSummary&lt;/b&gt;&lt;br&gt;&amp;bull; Generates shadow aggregates without triggering analyst emails&lt;br&gt;&amp;bull; Records metrics with &lt;code&gt;parser_class=&quot;GoParser&quot;&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="790" y="785" width="620" height="150" as_="geometry" /></mxCell><mxCell id="edge_b2_b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="path_b_step2" target="path_b_step3" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="path_b_step4" value="&lt;b style=&quot;font-size:14px; color:#6d28d9;&quot;&gt;4. Shadow Finalization Outcomes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;background-color:#ffffff; border:1px solid #c4b5fd; border-radius:6px; padding:8px; margin-bottom:8px;&quot;&gt;&lt;b style=&quot;color:#5b21b6;&quot;&gt;Shadow Record State Audit:&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;code&gt;ShadowDataFile&lt;/code&gt; transitions to &lt;code&gt;PARSE_COMPLETED&lt;/code&gt; or &lt;code&gt;PARSED_WITH_ERRORS&lt;/code&gt;&lt;br&gt;&amp;bull; Production &lt;code&gt;DataFile&lt;/code&gt; outcome determined solely by Python parser&lt;br&gt;&amp;bull; Automated test/audit diffs compare production vs shadow accuracy&lt;/div&gt;&lt;div align=&quot;center&quot; style=&quot;background-color:#ede9fe; border:1px solid #ddd6fe; border-radius:4px; padding:6px; color:#5b21b6; font-size:12px;&quot;&gt;Allows 100% confidence verification before migrating production traffic&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#e9d5ff;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="790" y="960" width="620" height="250" as_="geometry" /></mxCell><mxCell id="edge_b3_b4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="path_b_step3" target="path_b_step4" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="col_c_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a7f3d0;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="1490" y="390" width="670" height="845" as_="geometry" /></mxCell><mxCell id="col_c_hdr" value="&lt;b style=&quot;font-size:15px; color:#ffffff;&quot;&gt;PATH C: go-only (Production Go Parser Worker)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;align=left;spacingLeft=20;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1490" y="390" width="670" height="48" as_="geometry" /></mxCell><mxCell id="path_c_step1" value="&lt;b style=&quot;font-size:14px; color:#065f46;&quot;&gt;1. Direct Go Worker Dispatch&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;ParsingService.schedule()&lt;/b&gt; marks state: &lt;code&gt;PARSE_STARTED&lt;/code&gt;&lt;br&gt;&amp;bull; Actor attribution: &lt;code&gt;actor=&quot;go_parser&quot;&lt;/code&gt; in lifecycle log&lt;br&gt;&amp;bull; Dispatches to &lt;code&gt;go-parser&lt;/code&gt; queue via &lt;b&gt;queue_go_parse()&lt;/b&gt;&lt;br&gt;&amp;bull; Python &lt;code&gt;parse.delay&lt;/code&gt; task is &lt;b&gt;skipped completely&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;right&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 10px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;GO AUTHORITATIVE&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="1515" y="460" width="620" height="115" as_="geometry" /></mxCell><mxCell id="path_c_step2" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;2. High-Performance Go Execution&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Go parser worker pulls task from Redis queue&lt;br&gt;&amp;bull; High throughput, compiled streaming validation &amp;amp; extraction&lt;br&gt;&amp;bull; Inserts live data directly into production database tables&lt;br&gt;&amp;bull; Collects row-level error counts &amp;amp; execution duration metrics&lt;br&gt;&amp;bull; Hands off finalization to Python &lt;code&gt;ParsingService.post_parse()&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="1515" y="600" width="620" height="160" as_="geometry" /></mxCell><mxCell id="edge_c1_c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="path_c_step1" target="path_c_step2" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="path_c_step3" value="&lt;b style=&quot;font-size:14px; color:#166534;&quot;&gt;3. Unified ParsingService.post_parse() Finalization&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Celery task &lt;b&gt;post_parse(data_file_id, table_mode=&quot;go-only&quot;)&lt;/b&gt;&lt;br&gt;&amp;bull; Instantiates &lt;b&gt;ParsingService.for_post_parse(table_mode=&quot;go-only&quot;)&lt;/b&gt;&lt;br&gt;&amp;bull; Bound to production &lt;b&gt;DataFile&lt;/b&gt; &amp;amp; &lt;b&gt;DataFileSummary&lt;/b&gt;&lt;br&gt;&amp;bull; Generates authoritative Excel error report file&lt;br&gt;&amp;bull; Dispatches notification emails to STT Data Analysts via &lt;code&gt;send_data_submitted_email&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="1515" y="785" width="620" height="150" as_="geometry" /></mxCell><mxCell id="edge_c2_c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="path_c_step2" target="path_c_step3" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="path_c_step4" value="&lt;b style=&quot;font-size:14px; color:#047857;&quot;&gt;4. Production Terminal Outcomes&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;background-color:#ffffff; border:1px solid #86efac; border-radius:6px; padding:6px; margin-bottom:6px;&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;PARSE_COMPLETED&lt;/span&gt;&amp;nbsp;&lt;b&gt;Clean Parse&lt;/b&gt; &amp;bull; Summary: &lt;code&gt;ACCEPTED&lt;/code&gt;&lt;br&gt;&lt;span style=&quot;color:#64748b; font-size:11px;&quot;&gt;Metrics: parser_class=&quot;GoParser&quot;, execution_duration_ms&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background-color:#ffffff; border:1px solid #fcd34d; border-radius:6px; padding:6px; margin-bottom:6px;&quot;&gt;&lt;span style=&quot;background-color:#fef3c7; border:1px solid #f59e0b; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b45309; font-size:11px;&quot;&gt;PARSED_WITH_ERRORS&lt;/span&gt;&amp;nbsp;&lt;b&gt;Errors Found&lt;/b&gt; &amp;bull; Summary: &lt;code&gt;ACCEPTED_WITH_ERRORS&lt;/code&gt;&lt;br&gt;&lt;span style=&quot;color:#64748b; font-size:11px;&quot;&gt;Downloadable error report ready for STT data analysts&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;background-color:#ffffff; border:1px solid #fca5a5; border-radius:6px; padding:6px;&quot;&gt;&lt;span style=&quot;background-color:#fee2e2; border:1px solid #f87171; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b91c1c; font-size:11px;&quot;&gt;PARSE_FAILED&lt;/span&gt;&amp;nbsp;&lt;b&gt;Parser Failure / Panic&lt;/b&gt; &amp;bull; Summary: &lt;code&gt;REJECTED&lt;/code&gt;&lt;br&gt;&lt;span style=&quot;color:#64748b; font-size:11px;&quot;&gt;parse_error recorded; analyst notified of submission rejection&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=12;" parent="1" vertex="1"><mxGeometry x="1515" y="960" width="620" height="250" as_="geometry" /></mxCell><mxCell id="edge_c3_c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="path_c_step3" target="path_c_step4" edge="1"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="stage3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="40" y="1260" width="2120" height="270" as_="geometry" /></mxCell><mxCell id="stage3_title" value="&lt;b style=&quot;font-size:15px; color:#1e293b;&quot;&gt;KEY ARCHITECTURAL ADVANCEMENTS IN THE NEW PARSING SERVICE&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="1270" width="800" height="30" as_="geometry" /></mxCell><mxCell id="card_1" value="&lt;b style=&quot;font-size:13px; color:#1e40af;&quot;&gt;Permanent Lifecycle Orchestrator&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;code&gt;ParsingService&lt;/code&gt; is the permanent lifecycle backbone&lt;br&gt;&amp;bull; Owns dispatching, scheduling, tokens, &amp;amp; post_parse&lt;br&gt;&amp;bull; Does NOT get deleted when Python parser is retired!&lt;br&gt;&amp;bull; Single source of truth for submission state transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="75" y="1315" width="390" height="135" as_="geometry" /></mxCell><mxCell id="card_2" value="&lt;b style=&quot;font-size:13px; color:#5b21b6;&quot;&gt;Unified Lifecycle Engine&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Python parse (&lt;code&gt;run()&lt;/code&gt;) &amp;amp; Go parse (&lt;code&gt;post_parse()&lt;/code&gt;)&lt;br&gt;&amp;bull; Both use identical artifact &amp;amp; DFS generation logic&lt;br&gt;&amp;bull; Zero code duplication when Python parser is retired&lt;br&gt;&amp;bull; Shared table routing: &lt;code&gt;ParserModelSet&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="500" y="1315" width="390" height="135" as_="geometry" /></mxCell><mxCell id="card_3" value="&lt;b style=&quot;font-size:13px; color:#065f46;&quot;&gt;Memory Safety &amp;amp; Serialization&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Prevents OOM crashes on files with 10k+ errors&lt;br&gt;&amp;bull; Errors fetched lazily; count stored as primitive&lt;br&gt;&amp;bull; &lt;b&gt;ParseResult.to_dict()&lt;/b&gt; serializes primitives&lt;br&gt;&amp;bull; Celery task returns lightweight JSON dictionary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="925" y="1315" width="390" height="135" as_="geometry" /></mxCell><mxCell id="card_4" value="&lt;b style=&quot;font-size:13px; color:#92400e;&quot;&gt;Transient Engine Decoupling&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;PythonParserEngine&lt;/b&gt; encapsulates legacy validation&lt;br&gt;&amp;bull; Temporary strategy behind clean execution boundary&lt;br&gt;&amp;bull; Celery task layer (&lt;code&gt;parser_task.py&lt;/code&gt;) reduced to ~80 lines&lt;br&gt;&amp;bull; Deleting Python parser leaves lifecycle 100% intact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="1350" y="1315" width="390" height="135" as_="geometry" /></mxCell><mxCell id="card_5" value="&lt;b style=&quot;font-size:13px; color:#9d174d;&quot;&gt;Audit Metrics in Transitions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Metrics in &lt;code&gt;DataFileStateTransition.metadata&lt;/code&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;code&gt;execution_duration_ms&lt;/code&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;code&gt;total_records_processed&lt;/code&gt;, &lt;code&gt;total_errors_generated&lt;/code&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;code&gt;parser_class&lt;/code&gt; (Python or GoParser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#fbcfe8;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="1775" y="1315" width="350" height="135" as_="geometry" /></mxCell><mxCell id="footer_text" value="&lt;div align=&quot;center&quot; style=&quot;color:#64748b; font-size:13px;&quot;&gt;Architecture: &lt;b&gt;DataFile&lt;/b&gt; / &lt;b&gt;ShadowDataFile&lt;/b&gt; &amp;rarr; &lt;b&gt;ParsingService&lt;/b&gt; &amp;rarr; &lt;b&gt;PythonParserEngine&lt;/b&gt; / &lt;b&gt;Go Worker&lt;/b&gt; &amp;rarr; &lt;b&gt;DataFileSummary&lt;/b&gt; &amp;rarr; &lt;b&gt;DataFileStateTransition&lt;/b&gt; &amp;rarr; &lt;b&gt;ParseResult&lt;/b&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="40" y="1475" width="2120" height="30" as_="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>