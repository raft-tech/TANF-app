<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net" modified="2026-10-22T22:30:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="golang-parsing-flow" name="Golang Parser Flow">
    <mxGraphModel dx="2100" dy="1760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1760" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="header_banner" value="&lt;b style=&quot;font-size:24px; color:#0f172a;&quot;&gt;TDP File Upload &amp; Processing Flow — Go Parser Path&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px; color:#475569;&quot;&gt;High-Throughput Go Parser Worker, Dual Dispatch Shadow Table Parity, Unified Post-Parse Orchestration &amp; State Transitions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=30;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="30" width="2020" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stage1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="130" width="2020" height="215" as="geometry" />
        </mxCell>
        <mxCell id="stage1_hdr" value="&lt;b style=&quot;font-size:15px; color:#1e293b; letter-spacing:0.5px;&quot;&gt;STAGE 1: FILE INGESTION, ANTIVIRUS SCANNING, FEATURE FLAG ROUTING &amp; DISPATCH&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="130" width="2020" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step1_1" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;1. Ingestion &amp; Storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFileViewSet.create&lt;/span&gt; receives file&lt;br&gt;&amp;bull; Uploads file stream directly to S3&lt;br&gt;&amp;bull; Sets &lt;b&gt;upload_source&lt;/b&gt;: &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;Frontend&lt;/span&gt; | &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;API&lt;/span&gt;&lt;br&gt;&amp;bull; Creates initial &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile&lt;/span&gt; record&lt;br&gt;&lt;br&gt;&lt;div align=&quot;right&quot;&gt;&lt;span style=&quot;background-color:#e0f2fe; border:1px solid #7dd3fc; border-radius:10px; padding:2px 8px; font-weight:bold; color:#0369a1; font-size:11px;&quot;&gt;UPLOADED&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="65" y="185" width="410" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step1_2" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;2. ClamAV Antivirus Scan&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Asynchronous inspection via &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;clamav_service&lt;/span&gt;&lt;br&gt;&amp;bull; Validates clean payload against virus database&lt;br&gt;&amp;bull; On completion, triggers &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParsingService.schedule()&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;right&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;VIRUS_SCAN_COMPLETED&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="515" y="185" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step1_3" value="&lt;b style=&quot;font-size:14px; color:#059669;&quot;&gt;3. ParsingService.schedule() &amp; Route Locking&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Evaluates &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go_parser_mode&lt;/span&gt; feature flag: &lt;b&gt;go-shadow&lt;/b&gt; or &lt;b&gt;go-only&lt;/b&gt;&lt;br&gt;&amp;bull; Persists durable route into &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile.parser_mode&lt;/span&gt; (idempotent)&lt;br&gt;&amp;bull; &lt;b&gt;claim_parse(data_file)&lt;/b&gt;: assigns exclusive UUID &lt;b&gt;parse_token&lt;/b&gt;&lt;br&gt;&amp;bull; If shadow mode: &lt;b&gt;create_or_update_shadow_data_file()&lt;/b&gt; creates parallel shadow record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="975" y="185" width="550" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step1_4" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;4. Go Celery Queue Dispatch&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Dispatches via &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;queue_go_parse()&lt;/span&gt; to queue: &lt;b&gt;go-parser&lt;/b&gt;&lt;br&gt;&amp;bull; Celery task: &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;tdpservice.scheduling.parser_task.go_parse&lt;/span&gt;&lt;br&gt;&amp;bull; Payload: &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;data_file_id&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;reparse_id&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;table_mode&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parse_token&lt;/span&gt;&lt;br&gt;&amp;bull; &lt;b&gt;go-only&lt;/b&gt;: sets state &amp;rarr; &lt;b&gt;PARSE_STARTED&lt;/b&gt; (actor=&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go_parser&lt;/span&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1565" y="185" width="470" height="140" as="geometry" />
        </mxCell>
        <mxCell id="edge_1_1_to_1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step1_1" target="step1_2" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_1_2_to_1_3" value="CLEAN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#15803d;strokeWidth=2;fontColor=#15803d;fontSize=10;fontStyle=1;endArrow=block;endFill=1;" parent="1" source="step1_2" target="step1_3" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_1_3_to_1_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step1_3" target="step1_4" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="stage2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a7f3d0;strokeWidth=2;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="365" width="2020" height="395" as="geometry" />
        </mxCell>
        <mxCell id="stage2_hdr" value="&lt;b style=&quot;font-size:15px; color:#ffffff;&quot;&gt;STAGE 2: GO PARSER WORKER STREAMING EXECUTION &amp; TABLE PARTITIONING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=none;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="365" width="2020" height="42" as="geometry" />
        </mxCell>
        <mxCell id="col_go_only_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="65" y="425" width="960" height="315" as="geometry" />
        </mxCell>
        <mxCell id="col_go_only_hdr" value="&lt;b style=&quot;font-size:14px; color:#065f46;&quot;&gt;PATH 1: go-only (Authoritative Production Worker)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;strokeWidth=1;align=left;spacingLeft=15;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="65" y="425" width="960" height="35" as="geometry" />
        </mxCell>
        <mxCell id="go_only_content" value="&amp;bull; &lt;b&gt;Direct Go Worker Execution&lt;/b&gt;: Go daemon consumes task from &lt;span style=&quot;background:transparent; background-color:transparent; color:#065f46; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go-parser&lt;/span&gt; queue&lt;br&gt;&amp;bull; &lt;b&gt;High-Speed Streaming&lt;/b&gt;: Streams raw S3 bytes; compiles regex and field validations in Go&lt;br&gt;&amp;bull; &lt;b&gt;Production Relational Writes&lt;/b&gt;: Directly populates production tables (&lt;span style=&quot;background:transparent; background-color:transparent; color:#065f46; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;tanf_t1...t7&lt;/span&gt;)&lt;br&gt;&amp;bull; &lt;b&gt;Error Logging&lt;/b&gt;: Records row-level validation errors into production &lt;span style=&quot;background:transparent; background-color:transparent; color:#065f46; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParserError&lt;/span&gt; table&lt;br&gt;&amp;bull; &lt;b&gt;Handoff to Post-Parse&lt;/b&gt;: Emits Celery completion task to Python worker:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;rarr; &lt;span style=&quot;background:transparent; background-color:transparent; color:#065f46; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;post_parse(data_file_id, table_mode=&quot;go-only&quot;, parse_error=...)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;right&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 10px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;GO AUTHORITATIVE &amp;bull; PARSE_STARTED&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="75" y="470" width="940" height="255" as="geometry" />
        </mxCell>
        <mxCell id="col_go_shadow_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#c4b5fd;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1065" y="425" width="970" height="315" as="geometry" />
        </mxCell>
        <mxCell id="col_go_shadow_hdr" value="&lt;b style=&quot;font-size:14px; color:#5b21b6;&quot;&gt;PATH 2: go-shadow (Dual Dispatch &amp; Shadow Partitioning)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#c4b5fd;strokeWidth=1;align=left;spacingLeft=15;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1065" y="425" width="970" height="35" as="geometry" />
        </mxCell>
        <mxCell id="go_shadow_content" value="&amp;bull; &lt;b&gt;Dual Dispatch&lt;/b&gt;: &lt;span style=&quot;background:transparent; background-color:transparent; color:#5b21b6; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParsingService.schedule()&lt;/span&gt; dispatches Python AND Go tasks concurrently&lt;br&gt;&amp;bull; &lt;b&gt;Production Path&lt;/b&gt;: Python parses live &lt;span style=&quot;background:transparent; background-color:transparent; color:#5b21b6; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile&lt;/span&gt; and populates production tables&lt;br&gt;&amp;bull; &lt;b&gt;Shadow Path&lt;/b&gt;: Go worker parses file concurrently and writes strictly to shadow tables:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;span style=&quot;background:transparent; background-color:transparent; color:#5b21b6; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;shadow_tanf_t1...t7&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#5b21b6; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ShadowParserError&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#5b21b6; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ShadowDataFile&lt;/span&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Zero Production Contention&lt;/b&gt;: Completely isolated from live queries, frontend API, and user exports&lt;br&gt;&amp;bull; &lt;b&gt;Automated Parity Diffs&lt;/b&gt;: Automated test suites compare production vs shadow outputs to guarantee 100% parity&lt;br&gt;&amp;bull; &lt;b&gt;Handoff&lt;/b&gt;: Dispatches &lt;span style=&quot;background:transparent; background-color:transparent; color:#5b21b6; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;post_parse(data_file_id, table_mode=&quot;go-shadow&quot;)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;right&quot;&gt;&lt;span style=&quot;background-color:#f5f3ff; border:1px solid #c4b5fd; border-radius:10px; padding:2px 10px; font-weight:bold; color:#6d28d9; font-size:11px;&quot;&gt;SHADOW ISOLATION &amp;bull; PARALLEL VALIDATION&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1075" y="470" width="950" height="255" as="geometry" />
        </mxCell>
        <mxCell id="edge_dispatch_go_only" value="mode: go-only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;fontColor=#059669;fontSize=10;fontStyle=1;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" parent="1" source="step1_4" target="col_go_only_bg" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1682" y="340" />
              <mxPoint x="545" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_dispatch_go_shadow" value="mode: go-shadow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7c3aed;strokeWidth=2;fontColor=#7c3aed;fontSize=10;fontStyle=1;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" parent="1" source="step1_4" target="col_go_shadow_bg" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1917" y="340" />
              <mxPoint x="1550" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="stage3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="780" width="2020" height="240" as="geometry" />
        </mxCell>
        <mxCell id="stage3_hdr" value="&lt;b style=&quot;font-size:15px; color:#1e293b;&quot;&gt;STAGE 3: UNIFIED POST-PARSE ORCHESTRATION (ParsingService.post_parse)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="780" width="2020" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step3_1" value="&lt;b style=&quot;font-size:14px; color:#166534;&quot;&gt;1. Celery post_parse Task&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Task: &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;post_parse(data_file_id, table_mode, ...)&lt;/span&gt;&lt;br&gt;&amp;bull; Executed by Python Celery worker&lt;br&gt;&amp;bull; Instantiates &lt;b&gt;ParsingService.for_post_parse()&lt;/b&gt;&lt;br&gt;&amp;bull; Encapsulates all Go post-processing in Django" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="65" y="835" width="460" height="165" as="geometry" />
        </mxCell>
        <mxCell id="step3_2" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;2. Dynamic ParserModelSet Binding&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;b&gt;_parser_models_for_mode(table_mode)&lt;/b&gt; resolves tables:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go-only&lt;/span&gt; &amp;rarr; &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFileSummary&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParserError&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go-shadow&lt;/span&gt; &amp;rarr; &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ShadowDataFile&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ShadowDataFileSummary&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ShadowParserError&lt;/span&gt;&lt;br&gt;&amp;bull; Same post-parse logic serves both production and shadow partitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="560" y="835" width="480" height="165" as="geometry" />
        </mxCell>
        <mxCell id="step3_3" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;3. Artifact Generation &amp; Aggregations&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Aggregates case error counts and consistency stats&lt;br&gt;&amp;bull; Invokes &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ErrorReportFactory&lt;/span&gt; to build Excel report (&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;.xlsx&lt;/span&gt;)&lt;br&gt;&amp;bull; Dispatches notification email via &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;send_data_submitted_email&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(Emails sent for &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go-only&lt;/span&gt;; suppressed for &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go-shadow&lt;/span&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1075" y="835" width="460" height="165" as="geometry" />
        </mxCell>
        <mxCell id="step3_4" value="&lt;b style=&quot;font-size:14px; color:#0f172a;&quot;&gt;4. Transition Metrics Appending&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Compiles execution metrics into dictionary:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parser_class: &quot;GoParser&quot;&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;total_records_processed&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;total_errors_generated&lt;/span&gt;&lt;br&gt;&amp;bull; Records metrics in &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFileStateTransition.metadata&lt;/span&gt;&lt;br&gt;&amp;bull; Releases ownership lock: &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;current_parse_token = None&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1570" y="835" width="465" height="165" as="geometry" />
        </mxCell>
        <mxCell id="edge_go_only_to_p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" parent="1" source="col_go_only_bg" target="step3_1" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_go_shadow_to_p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" parent="1" source="col_go_shadow_bg" target="step3_1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1550" y="760" />
              <mxPoint x="410" y="760" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_p1_p2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step3_1" target="step3_2" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_p2_p3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step3_2" target="step3_3" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_p3_p4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="step3_3" target="step3_4" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="stage4_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="1040" width="2020" height="220" as="geometry" />
        </mxCell>
        <mxCell id="stage4_hdr" value="&lt;b style=&quot;font-size:15px; color:#1e293b;&quot;&gt;STAGE 4: TERMINAL LIFECYCLE STATE OUTCOMES (GO PARSER PATH)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="1040" width="2020" height="40" as="geometry" />
        </mxCell>
        <mxCell id="out1" value="&lt;b style=&quot;font-size:14px; color:#15803d;&quot;&gt;Outcome 1: Clean Parse Success&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Summary Status: &lt;span style=&quot;background:transparent; background-color:transparent; color:#15803d; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ACCEPTED&lt;/span&gt; (0 errors recorded)&lt;br&gt;&amp;bull; State: &lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:11px;&quot;&gt;PARSE_COMPLETED&lt;/span&gt;&lt;br&gt;&amp;bull; Production tables populated with high-throughput compiled Go speed&lt;br&gt;&amp;bull; Transition metadata stamped with &lt;span style=&quot;background:transparent; background-color:transparent; color:#15803d; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parser_class=&quot;GoParser&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="65" y="1095" width="620" height="145" as="geometry" />
        </mxCell>
        <mxCell id="out2" value="&lt;b style=&quot;font-size:14px; color:#b45309;&quot;&gt;Outcome 2: Validation Errors Encountered&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Summary Status: &lt;span style=&quot;background:transparent; background-color:transparent; color:#b45309; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ACCEPTED_WITH_ERRORS&lt;/span&gt; or &lt;span style=&quot;background:transparent; background-color:transparent; color:#b45309; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;PARTIALLY_ACCEPTED&lt;/span&gt;&lt;br&gt;&amp;bull; State: &lt;span style=&quot;background-color:#fef3c7; border:1px solid #f59e0b; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b45309; font-size:11px;&quot;&gt;PARSED_WITH_ERRORS&lt;/span&gt;&lt;br&gt;&amp;bull; Errors serialized to &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParserError&lt;/span&gt; table by Go worker&lt;br&gt;&amp;bull; Downloadable Excel error report generated by Python &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;post_parse()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="735" y="1095" width="630" height="145" as="geometry" />
        </mxCell>
        <mxCell id="out3" value="&lt;b style=&quot;font-size:14px; color:#b91c1c;&quot;&gt;Outcome 3: Go Worker Error / Panic&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Summary Status: &lt;span style=&quot;background:transparent; background-color:transparent; color:#b91c1c; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;REJECTED&lt;/span&gt;&lt;br&gt;&amp;bull; State: &lt;span style=&quot;background-color:#fee2e2; border:1px solid #f87171; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b91c1c; font-size:11px;&quot;&gt;PARSE_FAILED&lt;/span&gt;&lt;br&gt;&amp;bull; Go worker passes &lt;span style=&quot;background:transparent; background-color:transparent; color:#b91c1c; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parse_error&lt;/span&gt; string to &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;post_parse()&lt;/span&gt;&lt;br&gt;&amp;bull; Error reason recorded in &lt;span style=&quot;background:transparent; background-color:transparent; color:#b91c1c; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFileStateTransition.metadata[&quot;parse_error&quot;]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;strokeWidth=1.5;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1415" y="1095" width="620" height="145" as="geometry" />
        </mxCell>
        <mxCell id="edge_p4_out1" value="0 Errors" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#15803d;strokeWidth=1.8;fontColor=#15803d;fontSize=10;fontStyle=1;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" parent="1" source="step3_4" target="out1" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_p4_out2" value="Validation Errors" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b45309;strokeWidth=1.8;fontColor=#b45309;fontSize=10;fontStyle=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="step3_4" target="out2" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_p4_out3" value="Worker Failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b91c1c;strokeWidth=1.8;fontColor=#b91c1c;fontSize=10;fontStyle=1;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" parent="1" source="step3_4" target="out3" edge="1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="stage5_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="1280" width="2020" height="205" as="geometry" />
        </mxCell>
        <mxCell id="stage5_hdr" value="&lt;b style=&quot;font-size:15px; color:#1e293b;&quot;&gt;ARCHITECTURAL CONCEPTS &amp; PATTERNS (GO PARSER PATH)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="1280" width="2020" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b style=&quot;font-size:13px; color:#1e40af;&quot;&gt;Permanent Lifecycle Orchestrator&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParsingService&lt;/span&gt; is the permanent Django service layer&lt;br&gt;&amp;bull; Owns routing, scheduling, state transitions, &amp; post-parse&lt;br&gt;&amp;bull; Survives the eventual deprecation of the Python parser&lt;br&gt;&amp;bull; Centralizes lifecycle logic without fragmenting across tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="65" y="1335" width="470" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b style=&quot;font-size:13px; color:#065f46;&quot;&gt;High-Throughput Go Streaming Worker&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Standalone compiled Go daemon running in dedicated worker container&lt;br&gt;&amp;bull; Consumes directly from Redis queue: &lt;span style=&quot;background:transparent; background-color:transparent; color:#065f46; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go-parser&lt;/span&gt;&lt;br&gt;&amp;bull; Multi-threaded, low-memory, compiled parsing of large files&lt;br&gt;&amp;bull; Hands off Django finalization cleanly via Celery &lt;span style=&quot;background:transparent; background-color:transparent; color:#065f46; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;post_parse&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="565" y="1335" width="470" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b style=&quot;font-size:13px; color:#5b21b6;&quot;&gt;Shadow Partitioning &amp; Parity Testing&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Dual dispatch allows running Go alongside Python in real time&lt;br&gt;&amp;bull; Writes to shadow tables (&lt;span style=&quot;background:transparent; background-color:transparent; color:#5b21b6; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ShadowDataFile&lt;/span&gt;, &lt;span style=&quot;background:transparent; background-color:transparent; color:#5b21b6; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ShadowParserError&lt;/span&gt;)&lt;br&gt;&amp;bull; Automated diff testing verifies 100% equivalence before migration&lt;br&gt;&amp;bull; Zero risk to production users during testing phases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1065" y="1335" width="470" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b style=&quot;font-size:13px; color:#92400e;&quot;&gt;Unified Post-Parse Engine (post_parse)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;bull; Single Python entrypoint handles finalization for Go tasks&lt;br&gt;&amp;bull; &lt;span style=&quot;background:transparent; background-color:transparent; color:#92400e; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ParserModelSet&lt;/span&gt; abstracts production vs shadow models&lt;br&gt;&amp;bull; Generates official Excel error report and dispatches emails&lt;br&gt;&amp;bull; Records unified metrics (&lt;span style=&quot;background:transparent; background-color:transparent; color:#92400e; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parser_class=&quot;GoParser&quot;&lt;/span&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;strokeWidth=1.2;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1565" y="1335" width="470" height="130" as="geometry" />
        </mxCell>
        <mxCell id="stage6_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="40" y="1505" width="2020" height="235" as="geometry" />
        </mxCell>
        <mxCell id="stage6_hdr" value="&lt;b style=&quot;font-size:15px; color:#1e293b;&quot;&gt;ROUTING MODES &amp; SUBMISSION LIFECYCLE STATES GLOSSARY (GO PARSER PATH)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1.5;align=left;spacingLeft=25;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="1505" width="2020" height="40" as="geometry" />
        </mxCell>
        <mxCell id="glossary_table_go" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-size:11px; color:#1e293b;&quot;&gt;&lt;tr style=&quot;background-color:#f1f5f9; text-align:left; border-bottom:2px solid #cbd5e1;&quot;&gt;  &lt;th style=&quot;padding:6px 10px; width:170px;&quot;&gt;Mode / State&lt;/th&gt;  &lt;th style=&quot;padding:6px 10px; width:150px;&quot;&gt;Category&lt;/th&gt;  &lt;th style=&quot;padding:6px 10px; width:220px;&quot;&gt;Target Model / Queue&lt;/th&gt;  &lt;th style=&quot;padding:6px 10px;&quot;&gt;Lifecycle Description &amp; Execution Behavior&lt;/th&gt;  &lt;th style=&quot;padding:6px 10px; width:90px; text-align:center;&quot;&gt;Terminal?&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#ffffff;&quot;&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;&lt;b style=&quot;color:#059669; font-family:monospace;&quot;&gt;go-only&lt;/b&gt;&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Parser Route Mode&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Queue: &lt;span style=&quot;background:transparent; background-color:transparent; color:#059669; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go-parser&lt;/span&gt; (Worker: Go)&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Production Go parser mode. Bypasses Python parse task completely. Go worker parses file and populates production tables.&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px; text-align:center; color:#64748b;&quot;&gt;N/A&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#f8fafc;&quot;&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;&lt;b style=&quot;color:#7c3aed; font-family:monospace;&quot;&gt;go-shadow&lt;/b&gt;&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Parser Route Mode&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Queues: &lt;span style=&quot;background:transparent; background-color:transparent; color:#7c3aed; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;celery&lt;/span&gt; &amp;amp; &lt;span style=&quot;background:transparent; background-color:transparent; color:#7c3aed; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go-parser&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Dual dispatch mode. Python writes to production tables; Go worker writes to shadow tables. Used for parity verification.&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px; text-align:center; color:#64748b;&quot;&gt;N/A&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#ffffff;&quot;&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:10px;&quot;&gt;PARSE_STARTED&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Lifecycle State&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile.state&lt;/span&gt; (actor=&lt;span style=&quot;background:transparent; background-color:transparent; color:#059669; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go_parser&lt;/span&gt;)&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Set during dispatch in &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;go-only&lt;/span&gt; mode or upon Go worker claiming task. Logged with actor attribution.&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px; text-align:center; color:#64748b;&quot;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#f8fafc;&quot;&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;&lt;span style=&quot;background-color:#dcfce7; border:1px solid #4ade80; border-radius:10px; padding:2px 8px; font-weight:bold; color:#15803d; font-size:10px;&quot;&gt;PARSE_COMPLETED&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Terminal State&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile&lt;/span&gt; / &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ShadowDataFile&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Clean parse with 0 errors. Stamped with &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parser_class=&quot;GoParser&quot;&lt;/span&gt; and duration metrics in transition metadata.&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px; text-align:center; font-weight:bold; color:#15803d;&quot;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-bottom:1px solid #e2e8f0; background-color:#ffffff;&quot;&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;&lt;span style=&quot;background-color:#fef3c7; border:1px solid #f59e0b; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b45309; font-size:10px;&quot;&gt;PARSED_WITH_ERRORS&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Terminal State&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile&lt;/span&gt; / &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ShadowDataFile&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Go worker detected validation errors. Excel error report created by &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;post_parse()&lt;/span&gt; and made available in UI.&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px; text-align:center; font-weight:bold; color:#b45309;&quot;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#f8fafc;&quot;&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;&lt;span style=&quot;background-color:#fee2e2; border:1px solid #f87171; border-radius:10px; padding:2px 8px; font-weight:bold; color:#b91c1c; font-size:10px;&quot;&gt;PARSE_FAILED&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Terminal State&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;&lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;DataFile&lt;/span&gt; / &lt;span style=&quot;background:transparent; background-color:transparent; color:#0369a1; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;ShadowDataFile&lt;/span&gt;&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px;&quot;&gt;Go worker encountered fatal panic or worker error. &lt;span style=&quot;background:transparent; background-color:transparent; color:#b91c1c; font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-weight:bold; font-size:11.5px;&quot;&gt;parse_error&lt;/span&gt; string attached to terminal transition record.&lt;/td&gt;  &lt;td style=&quot;padding:6px 10px; text-align:center; font-weight:bold; color:#b91c1c;&quot;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="65" y="1555" width="1970" height="175" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>