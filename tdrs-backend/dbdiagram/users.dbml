    history_date [type: btree, name: "users_historicaluser_history_date_c280194d"]
    history_user_id [type: btree, name: "users_historicaluser_history_user_id_7f91d047"]
    id [type: btree, name: "users_historicaluser_id_5e70dd03"]
    login_gov_uuid [type: btree, name: "users_historicaluser_login_gov_uuid_3997ba5c"]
    stt_id [type: btree, name: "users_historicaluser_stt_id_154da5c6"]
    username [type: btree, name: "users_historicaluser_username_8f7ba123"]
    username [type: btree, name: "users_historicaluser_username_8f7ba123_like"]
  }
}

