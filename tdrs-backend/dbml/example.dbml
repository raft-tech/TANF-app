    '50bfc1be-096a-4bf7-b9df-9fa67426e412', 'user_delete', 'User Delete', 'Permission to delete a user'
    'e48e4211-e793-4483-ad9a-546f268802fe', 'role_read', 'Role Read', 'Permission to read a role'
    '3962f41c-0f9a-4042-aa73-13d9da0fdb8b', 'role_create', 'Role Create', 'Permission to create a role'
    '17789261-91ee-4177-963d-fa18d4c0106b', 'role_update', 'Role Update', 'Permission to update a role'
    'eaaf14b1-e6e7-4f51-afc9-05aeef0f85c3', 'role_delete', 'Role Delete', 'Permission to delete a role'
    '667a280c-0ca1-452a-b135-8e69565417ef', 'permission_read', 'Permission Read', 'Permission to read a permission'
    '480b7872-b57a-4315-afb8-12e0ffa64e98', 'permission_create', 'Permission Create', 'Permission to create a permission'
    'a72f4bb4-6609-4326-a4d7-621e43648f45', 'permission_update', 'Permission Update', 'Permission to update a permission'
    '659a4335-7464-43ba-a8ba-fc85c82d38aa', 'permission_delete', 'Permission Delete', 'Permission to delete a permission'
  }
}

Table users.user_role [note: 'User Role Association Table'] {
  user_id uuid [not null, ref: > users.user.id, note: 'User ID']
  role_id uuid [not null, ref: > users.role.id, note: 'Role ID']

  indexes {
    (user_id, role_id) [pk, name: "pk_users_user_role", type: "btree"]
    user_id [name: "idx_users_user_role_user_id", type: "btree"]
    role_id [name: "idx_users_user_role_role_id", type: "btree"]
  }

  records (user_id, role_id) {
    '42924369-77c0-4c34-918a-a534aaad8932', 'd9b3e25a-7bfa-41b7-ae39-416a008f9d27'
    '019fb9e5-8c6e-702a-8eda-3019a1f089e5', 'daa16730-5e80-418b-bdc3-74bd23cb8eee'
    'e1107024-d6f2-4e03-a328-d9a7c45d1d7b', '967cbbe4-cc1c-4a19-95eb-cbb7a55273ff'
  }
}

