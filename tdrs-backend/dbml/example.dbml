Table users.user_permission [note: 'User Permission Association Table'] {
  user_id uuid [not null, ref: > users.user.id, note: 'User ID']
  permission_id uuid [not null, ref: > users.permission.id, note: 'Permission ID']

  indexes {
    (user_id, permission_id) [pk, name: "pk_users_user_permission", type: "btree"]
    user_id [name: "idx_users_user_permission_user_id", type: "btree"]
    permission_id [name: "idx_users_user_permission_permission_id", type: "btree"]
  }
}

Table users.preference [note: 'User Preference Table'] {
  user_id uuid [pk, ref: - users.user.id, note: 'User ID']
  theme varchar [not null, default: 'mui', note: 'Theme Preference']
  theme_mode enum('light', 'dark', 'system') [not null, default: 'system', note: 'Theme Mode Preference']
  date_format enum('MM/DD/YYYY', 'DD/MM/YYYY', 'YYYY-MM-DD', 'DD-MMM-YYYY') [not null, default: 'MM/DD/YYYY', note: 'Date Format Preference']

  indexes {
    user_id [name: "idx_users_preference_user_id", type: "btree"]
    theme [name: "idx_users_preference_theme", type: "btree"]
    theme_mode [name: "idx_users_preference_theme_mode", type: "btree"]
    date_format [name: "idx_users_preference_date_format", type: "btree"]
  }

  records (user_id, theme, theme_mode, date_format) {
    '42924369-77c0-4c34-918a-a534aaad8932', 'dark', 'dark', 'MM/DD/YYYY'
    '019fb9e5-8c6e-702a-8eda-3019a1f089e5', 'light', 'light', 'MM/DD/YYYY'
    'e1107024-d6f2-4e03-a328-d9a7c45d1d7b', 'system', 'system', 'MM/DD/YYYY'
  }
}
