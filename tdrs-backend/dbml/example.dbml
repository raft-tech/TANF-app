
Project easybutton {
  database_type: 'postgresql'
  Note: 'Real world example'
}

Table users.user [note: 'Users Table'] {
  id uuid [pk, note: 'User ID']
  name varchar [note: 'User Name']
  email varchar [unique, not null, note: 'User Email']
  enabled boolean [not null, default: true, note: 'User Enabled']
  account_non_expired boolean [not null, default: true, note: 'User Account Non Expired']
  account_non_locked boolean [not null, default: true, note: 'User Account Non Locked']
  credentials_non_expired boolean [not null, default: true, note: 'User Credentials Non Expired']
  last_login timestamp [note: 'User Last Login']
  created timestamp [not null, default: `now()`, note: 'User Created At']
  created_by uuid [not null, ref: > users.user.id, note: 'User Created By']
  modified timestamp [not null, default: `now()`, note: 'User Modified At']
  modified_by uuid [not null, ref: > users.user.id, note: 'User Modified By']

  indexes {
    id [name: "idx_user_user_id", type: "btree"]
    name [name: "idx_user_user_name", type: "btree"]
    email [name: "idx_user_user_email", type: "btree"]
    enabled [name: "idx_user_user_enabled", type: "btree"]
    account_non_expired [name: "idx_user_user_accountNonExpired", type: "btree"]
    account_non_locked [name: "idx_user_user_accountNonLocked", type: "btree"]
    credentials_non_expired [name: "idx_user_user_credentialsNonExpired", type: "btree"]
    last_login [name: "idx_user_user_last_login", type: "btree"]
    created [name: "idx_user_user_created", type: "btree"]
    created_by [name: "idx_user_user_created_by", type: "btree"]
    modified [name: "idx_user_user_modified", type: "btree"]
    modified_by [name: "idx_user_user_modified_by", type: "btree"]
  }

  records (id, name, email, enabled, account_non_expired, account_non_locked, credentials_non_expired, last_login, created, created_by, modified, modified_by) {
    '42924369-77c0-4c34-918a-a534aaad8932', 'Super Admin', 'super_admin@easybutton.org', true, true, true, true, '2022-01-01', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932'
    '019fb9e5-8c6e-702a-8eda-3019a1f089e5', 'Admin', 'admin@easybutton.org', true, true, true, true, '2022-01-01', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932'
    'e1107024-d6f2-4e03-a328-d9a7c45d1d7b', 'User', 'user@easybutton.org', true, true, true, true, '2022-01-01', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932'
  }
}

Table users.role [note: 'Roles Table'] {
  id uuid [pk, note: 'Role ID']
  name varchar [unique, not null, note: 'Role Name']
  display_name varchar [unique, not null, note: 'Role Display Name']
  description text [note: 'Role Description']
  created timestamp [not null, default: `now()`, note: 'Role Created At']
  created_by uuid [not null, ref: > users.user.id, note: 'Role Created By']
  modified timestamp [not null, default: `now()`, note: 'Role Modified At']
  modified_by uuid [not null, ref: > users.user.id, note: 'Role Modified By']

  indexes {
    id [name: "idx_user_role_id", type: "btree"]
    name [name: "idx_user_role_name", type: "btree"]
    display_name [name: "idx_user_role_display_name", type: "btree"]
    description [name: "idx_user_role_description", type: "btree"]
    created [name: "idx_user_role_created", type: "btree"]
    created_by [name: "idx_user_role_created_by", type: "btree"]
    modified [name: "idx_user_role_modified", type: "btree"]
    modified_by [name: "idx_user_role_modified_by", type: "btree"]
  }

  records (id, name, display_name, description, created, created_by, modified, modified_by) {
    'd9b3e25a-7bfa-41b7-ae39-416a008f9d27', 'super_admin', 'Super Admin', 'Super Admin Role that can do everything', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932'
    'daa16730-5e80-418b-bdc3-74bd23cb8eee', 'admin', 'Admin', 'Admin Role that can do everything except what is special to Super Admin', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932'
    '967cbbe4-cc1c-4a19-95eb-cbb7a55273ff', 'user', 'User', 'Basic User Role that can do basic stuff', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932', '2022-01-01', '42924369-77c0-4c34-918a-a534aaad8932'
  }
}

Table users.permission [note: 'Permissions Table'] {
  id uuid [pk, note: 'Permission ID']
  name varchar [unique, not null, note: 'Permission Name']
  display_name varchar [unique, not null, note: 'Permission Display Name']
  description text [note: 'Permission Description']

  indexes {
    id [name: "idx_user_permission_id", type: "btree"]
    name [name: "idx_user_permission_name", type: "btree"]
    display_name [name: "idx_user_permission_display_name", type: "btree"]
    description [name: "idx_user_permission_description", type: "btree"]
  }

  records (id, name, display_name, description) {
    '254b6ce9-c798-4964-8a9b-c99d46feaf3d', 'user_read', 'User Read', 'Permission to read a user'
