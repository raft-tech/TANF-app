// Django/DRF framework and admin tables (auth, sessions, celery beat, admin UI)

Table "django_migrations" {
  "id" int4 [pk, not null, increment]
  "app" varchar(255) [not null]
  "name" varchar(255) [not null]
  "applied" timestamptz [not null]
}

Table "django_content_type" {
  "id" int4 [pk, not null, increment]
  "app_label" varchar(100) [not null]
  "model" varchar(100) [not null]

  Indexes {
    (app_label, model) [type: btree, unique, name: "django_content_type_app_label_model_76bd3d3b_uniq"]
  }
}

Table "auth_permission" {
  "id" int4 [pk, not null, increment]
  "name" varchar(255) [not null]
  "content_type_id" int4 [not null, ref: > django_content_type.id]
  "codename" varchar(100) [not null]

  Indexes {
    (content_type_id, codename) [type: btree, unique, name: "auth_permission_content_type_id_codename_01ab375a_uniq"]
    content_type_id [type: btree, name: "auth_permission_content_type_id_2f476e4b"]
  }
}

Table "auth_group" {
  "id" int4 [pk, not null, increment]
  "name" varchar(150) [unique, not null]

  Indexes {
    name [type: btree, name: "auth_group_name_a6ea08ec_like"]
  }
}

Table "auth_group_permissions" {
  "id" int4 [pk, not null, increment]
  "group_id" int4 [not null, ref: > auth_group.id]
  "permission_id" int4 [not null, ref: > auth_permission.id]

  Indexes {
    (group_id, permission_id) [type: btree, unique, name: "auth_group_permissions_group_id_permission_id_0cd325b0_uniq"]
    group_id [type: btree, name: "auth_group_permissions_group_id_b120cbf9"]
    permission_id [type: btree, name: "auth_group_permissions_permission_id_84c5c92e"]
  }
}

Table "django_admin_log" {
  "id" int4 [pk, not null, increment]
  "action_time" timestamptz [not null]
  "object_id" text
  "object_repr" varchar(200) [not null]
  "action_flag" int2 [not null, check: `action_flag >= 0`]
  "change_message" text [not null]
  "content_type_id" int4 [ref: > django_content_type.id]
  "user_id" uuid [not null]

  Indexes {
    content_type_id [type: btree, name: "django_admin_log_content_type_id_c4bce8eb"]
    user_id [type: btree, name: "django_admin_log_user_id_c564eba6"]
  }
}

Table "admin_interface_theme" {
  "id" int4 [pk, not null, increment]
  "name" varchar(50) [unique, not null]
  "active" bool [not null]
  "title" varchar(50) [not null]
  "title_visible" bool [not null]
  "logo" varchar(100) [not null]
  "logo_visible" bool [not null]
  "css_header_background_color" varchar(10) [not null]
  "title_color" varchar(10) [not null]
  "css_header_text_color" varchar(10) [not null]
  "css_header_link_color" varchar(10) [not null]
  "css_header_link_hover_color" varchar(10) [not null]
  "css_module_background_color" varchar(10) [not null]
  "css_module_text_color" varchar(10) [not null]
  "css_module_link_color" varchar(10) [not null]
  "css_module_link_hover_color" varchar(10) [not null]
  "css_module_rounded_corners" bool [not null]
  "css_generic_link_color" varchar(10) [not null]
  "css_generic_link_hover_color" varchar(10) [not null]
  "css_save_button_background_color" varchar(10) [not null]
  "css_save_button_background_hover_color" varchar(10) [not null]
  "css_save_button_text_color" varchar(10) [not null]
  "css_delete_button_background_color" varchar(10) [not null]
  "css_delete_button_background_hover_color" varchar(10) [not null]
  "css_delete_button_text_color" varchar(10) [not null]
  "list_filter_dropdown" bool [not null]
  "related_modal_active" bool [not null]
  "related_modal_background_color" varchar(10) [not null]
  "related_modal_rounded_corners" bool [not null]
  "logo_color" varchar(10) [not null]
  "recent_actions_visible" bool [not null]
  "favicon" varchar(100) [not null]
  "related_modal_background_opacity" varchar(5) [not null]
  "env_name" varchar(50) [not null]
  "env_visible_in_header" bool [not null]
  "env_color" varchar(10) [not null]
  "env_visible_in_favicon" bool [not null]
  "related_modal_close_button_visible" bool [not null]
  "language_chooser_active" bool [not null]
  "language_chooser_display" varchar(10) [not null]
  "list_filter_sticky" bool [not null]
  "form_pagination_sticky" bool [not null]
  "form_submit_sticky" bool [not null]
  "css_module_background_selected_color" varchar(10) [not null]
  "css_module_link_selected_color" varchar(10) [not null]
  "logo_max_height" int2 [not null, check: `logo_max_height >= 0`]
  "logo_max_width" int2 [not null, check: `logo_max_width >= 0`]
  "foldable_apps" bool [not null]
  "language_chooser_control" varchar(20) [not null]
  "list_filter_highlight" bool [not null]
  "list_filter_removal_links" bool [not null]
  "show_fieldsets_as_tabs" bool [not null]
  "show_inlines_as_tabs" bool [not null]
  "css_generic_link_active_color" varchar(10) [not null]
  "collapsible_stacked_inlines" bool [not null]
  "collapsible_stacked_inlines_collapsed" bool [not null]
  "collapsible_tabular_inlines" bool [not null]
  "collapsible_tabular_inlines_collapsed" bool [not null]
  "form_actions_sticky" bool [not null]

  Indexes {
    name [type: btree, name: "admin_interface_theme_name_30bda70f_like"]
  }
}

Table "authtoken_token" {
  "key" varchar(40) [pk, not null]
  "created" timestamptz [not null]
  "user_id" uuid [unique, not null]

  Indexes {
    key [type: btree, name: "authtoken_token_key_10f0b77e_like"]
  }
}

Table "django_celery_beat_crontabschedule" {
  "id" int4 [pk, not null, increment]
  "minute" varchar(240) [not null]
  "hour" varchar(96) [not null]
  "day_of_week" varchar(64) [not null]
  "day_of_month" varchar(124) [not null]
  "month_of_year" varchar(64) [not null]
  "timezone" varchar(63) [not null]
}

Table "django_celery_beat_intervalschedule" {
  "id" int4 [pk, not null, increment]
  "every" int4 [not null]
  "period" varchar(24) [not null]
}

Table "django_celery_beat_periodictask" {
  "id" int4 [pk, not null, increment]
  "name" varchar(200) [unique, not null]
  "task" varchar(200) [not null]
  "args" text [not null]
  "kwargs" text [not null]
  "queue" varchar(200)
  "exchange" varchar(200)
  "routing_key" varchar(200)
  "expires" timestamptz
  "enabled" bool [not null]
  "last_run_at" timestamptz
  "total_run_count" int4 [not null, check: `total_run_count >= 0`]
  "date_changed" timestamptz [not null]
  "description" text [not null]
  "crontab_id" int4 [ref: > django_celery_beat_crontabschedule.id]
  "interval_id" int4 [ref: > django_celery_beat_intervalschedule.id]
  "solar_id" int4 [ref: > django_celery_beat_solarschedule.id]
  "one_off" bool [not null]
  "start_time" timestamptz
  "priority" int4 [check: `priority >= 0`]
  "headers" text [not null]
  "clocked_id" int4 [ref: > django_celery_beat_clockedschedule.id]
  "expire_seconds" int4 [check: `expire_seconds >= 0`]

  Indexes {
    clocked_id [type: btree, name: "django_celery_beat_periodictask_clocked_id_47a69f82"]
    crontab_id [type: btree, name: "django_celery_beat_periodictask_crontab_id_d3cba168"]
    interval_id [type: btree, name: "django_celery_beat_periodictask_interval_id_a8ca27da"]
    name [type: btree, name: "django_celery_beat_periodictask_name_265a36b7_like"]
    solar_id [type: btree, name: "django_celery_beat_periodictask_solar_id_a87ce72c"]
  }
}

Table "django_celery_beat_periodictasks" {
  "ident" int2 [pk, not null]
  "last_update" timestamptz [not null]
}

Table "django_celery_beat_solarschedule" {
  "id" int4 [pk, not null, increment]
  "event" varchar(24) [not null]
  "latitude" numeric(9,6) [not null]
  "longitude" numeric(9,6) [not null]

  Indexes {
    (event, latitude, longitude) [type: btree, unique, name: "django_celery_beat_solar_event_latitude_longitude_ba64999a_uniq"]
  }
}

Table "django_celery_beat_clockedschedule" {
  "id" int4 [pk, not null, increment]
  "clocked_time" timestamptz [not null]
}

Table "django_session" {
  "session_key" varchar(40) [pk, not null]
  "session_data" text [not null]
  "expire_date" timestamptz [not null]

  Indexes {
    expire_date [type: btree, name: "django_session_expire_date_a5c62663"]
    session_key [type: btree, name: "django_session_session_key_c0390e0f_like"]
  }
}

