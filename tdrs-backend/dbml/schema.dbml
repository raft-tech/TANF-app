  }
}


// tdpservice.users app: user accounts, feedback, change requests

Table "users_user" {
  "password" varchar(128) [not null]
  "last_login" timestamptz
  "is_superuser" bool [not null]
  "username" varchar(150) [unique, not null]
  "first_name" varchar(150) [not null]
  "last_name" varchar(150) [not null]
  "email" varchar(254) [not null]
  "is_staff" bool [not null]
  "is_active" bool [not null]
  "date_joined" timestamptz [not null]
  "id" uuid [pk, not null]
  "login_gov_uuid" uuid [unique]
  "hhs_id" varchar(12) [unique]
  "location_id" int4 [check: `location_id >= 0`]
  "location_type_id" int4 [ref: > django_content_type.id]
  "account_approval_status" varchar(40) [not null]
  "stt_id" int4 [ref: > stts_stt.id]
  "access_requested_date" timestamptz [not null]
  "feature_flags" jsonb [not null]

